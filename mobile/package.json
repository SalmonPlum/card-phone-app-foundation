{
  "name": "temporary-card-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "engines": { "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0" },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "test": "jest --watch=false",
    "test:domain": "node scripts/test-domain.mjs",
    "test:security": "node --test --experimental-test-isolation=none scripts/tooling-security.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:decks": "node --experimental-strip-types scripts/validate-decks.ts"
  },
  "dependencies": {
    "expo": "58.0.17",
    "expo-constants": "58.0.13",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "58.0.15",
    "expo-linking": "58.0.14",
    "expo-localization": "58.0.5",
    "expo-router": "58.0.26",
    "expo-status-bar": "58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "overrides": {
    "@expo/cli": {
      "zod": "4.6.7"
    }
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.14.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-expo": "58.0.4",
    "jest": "30.4.2",
    "jest-expo": "58.0.12",
    "test-renderer": "1.3.0",
    "typescript": "6.0.3"
  }
}
